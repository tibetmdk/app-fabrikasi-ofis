{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "App Fabrikasi Ofisi",
  "version": "1.1.1",
  "identifier": "com.appfabrikasi.ofis",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "App Fabrikası Ofisi",
        "width": 1440,
        "height": 900,
        "minWidth": 640,
        "minHeight": 500,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' http: https:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./nsis/hooks.nsh"
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "./linux/app-fabrikasi-ofis.desktop.hbs",
        "postInstallScript": "./linux/postinst.sh",
        "postRemoveScript": "./linux/postrm.sh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcxMUU1MjNBNkJDOEE2OUIKUldTYnBzaHJPbEllY1NSTnM5ZUQwcjRoZlZRUC9MSDQyQWs2eTduSUduYlZFT1hoRDV2cmhQOWQK",
      "endpoints": [
        "https://github.com/tibetmdk/app-fabrikasi-ofis/releases/latest/download/latest.json"
      ]
    }
  }
}
